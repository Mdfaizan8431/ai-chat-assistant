<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RAG Documents Manager</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #0f0f23;
            --secondary: #1a1a2e;
            --accent: #00ff88;
            --accent-glow: rgba(0, 255, 136, 0.2);
            --text: #e8e8e8;
            --text-dim: #8a8a8a;
            --border: rgba(255, 255, 255, 0.1);
            --error: #ff4444;
            --warning: #ffaa00;
            --info: #4da6ff;
        }

        body {
            font-family: 'Space Mono', monospace;
            background: var(--primary);
            color: var(--text);
            padding: 2rem;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        h1 {
            font-family: 'Syne', sans-serif;
            font-size: 2.5rem;
            margin-bottom: 1rem;
            background: linear-gradient(135deg, var(--accent) 0%, #667eea 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin: 2rem 0;
        }

        .stat-card {
            background: var(--secondary);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
        }

        .stat-number {
            font-size: 2.5rem;
            color: var(--accent);
            font-weight: 700;
            font-family: 'Syne', sans-serif;
        }

        .stat-label {
            color: var(--text-dim);
            font-size: 0.9rem;
            margin-top: 0.5rem;
        }

        .section {
            background: var(--secondary);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 2rem;
            margin: 2rem 0;
        }

        .section-title {
            font-family: 'Syne', sans-serif;
            font-size: 1.5rem;
            color: var(--accent);
            margin-bottom: 1.5rem;
        }

        .document-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .document-item {
            background: var(--primary);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
        }

        .document-item:hover {
            border-color: var(--accent);
            transform: translateX(5px);
        }

        .doc-info {
            flex: 1;
        }

        .doc-name {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 0.5rem;
        }

        .doc-meta {
            font-size: 0.85rem;
            color: var(--text-dim);
        }

        .doc-actions {
            display: flex;
            gap: 0.5rem;
        }

        button {
            background: var(--accent);
            color: var(--primary);
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-family: 'Syne', sans-serif;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px var(--accent-glow);
        }

        button.danger {
            background: var(--error);
        }

        button.secondary {
            background: var(--secondary);
            border: 1px solid var(--border);
            color: var(--text);
        }

        .empty-state {
            text-align: center;
            padding: 3rem;
            color: var(--text-dim);
        }

        .empty-icon {
            font-size: 4rem;
            margin-bottom: 1rem;
        }

        .chunk-preview {
            background: var(--primary);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1rem;
            margin-top: 1rem;
            max-height: 300px;
            overflow-y: auto;
        }

        .chunk-item {
            padding: 0.75rem;
            border-bottom: 1px solid var(--border);
            font-size: 0.9rem;
        }

        .chunk-item:last-child {
            border-bottom: none;
        }

        .back-link {
            display: inline-block;
            color: var(--accent);
            text-decoration: none;
            margin-bottom: 2rem;
            font-size: 1.1rem;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        .loading {
            text-align: center;
            padding: 2rem;
            color: var(--text-dim);
        }

        .refresh-btn {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        @media (max-width: 768px) {
            body {
                padding: 1rem;
            }

            h1 {
                font-size: 2rem;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/" class="back-link">← Back to Chat</a>
        
        <h1>📚 Documents Manager</h1>
        <p style="color: var(--text-dim); margin-bottom: 2rem;">
            View and manage your RAG document database
        </p>

        <!-- Statistics -->
        <div class="stats-grid" id="statsGrid">
            <div class="stat-card">
                <div class="stat-number" id="totalDocs">-</div>
                <div class="stat-label">Total Documents</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="totalChunks">-</div>
                <div class="stat-label">Total Chunks</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="avgChunks">-</div>
                <div class="stat-label">Avg Chunks/Doc</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="dbSize">-</div>
                <div class="stat-label">Database Size</div>
            </div>
        </div>

        <!-- Documents List -->
        <div class="section">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h2 class="section-title" style="margin: 0;">Uploaded Documents</h2>
                <button onclick="clearAllDocuments()" class="danger">🗑️ Clear All</button>
            </div>
            
            <div id="documentsList">
                <div class="loading">Loading documents...</div>
            </div>
        </div>

        <!-- Refresh Button -->
        <button class="refresh-btn" onclick="loadData()" title="Refresh">
            🔄
        </button>
    </div>

    <script>
        const API_BASE = '';
        
        async function loadData() {
            try {
                // Load health info for stats
                const healthResp = await fetch(`${API_BASE}/health`);
                const healthData = await healthResp.json();
                
                // Load documents list
                const docsResp = await fetch(`${API_BASE}/documents`);
                const docsData = await docsResp.json();
                
                // Update stats
                updateStats(healthData, docsData);
                
                // Update documents list
                updateDocumentsList(docsData);
                
            } catch (error) {
                console.error('Error loading data:', error);
                document.getElementById('documentsList').innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon">❌</div>
                        <p>Error loading documents</p>
                        <p style="font-size: 0.9rem; margin-top: 0.5rem;">${error.message}</p>
                    </div>
                `;
            }
        }
        
        function updateStats(healthData, docsData) {
            const totalDocs = docsData.uploaded_files?.length || 0;
            const totalChunks = docsData.total_chunks || 0;
            const avgChunks = totalDocs > 0 ? Math.round(totalChunks / totalDocs) : 0;
            
            // Estimate size (very rough estimate)
            const estimatedSize = totalChunks * 500; // ~500 chars per chunk
            const sizeKB = Math.round(estimatedSize / 1024);
            
            document.getElementById('totalDocs').textContent = totalDocs;
            document.getElementById('totalChunks').textContent = totalChunks;
            document.getElementById('avgChunks').textContent = avgChunks;
            document.getElementById('dbSize').textContent = sizeKB + ' KB';
        }
        
        function updateDocumentsList(docsData) {
            const container = document.getElementById('documentsList');
            
            if (!docsData.uploaded_files || docsData.uploaded_files.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon">📂</div>
                        <p>No documents uploaded yet</p>
                        <p style="font-size: 0.9rem; margin-top: 0.5rem;">
                            Go to the <a href="/" style="color: var(--accent);">chat interface</a> to upload documents
                        </p>
                    </div>
                `;
                return;
            }
            
            const totalChunks = docsData.total_chunks || 0;
            const totalDocs = docsData.uploaded_files.length;
            
            let html = '<div class="document-list">';
            
            docsData.uploaded_files.forEach((filename, index) => {
                // Estimate chunks per doc (rough)
                const estimatedChunks = Math.round(totalChunks / totalDocs);
                
                // Get file extension
                const ext = filename.split('.').pop().toUpperCase();
                
                // Get file icon
                const icon = ext === 'PDF' ? '📄' : '📝';
                
                html += `
                    <div class="document-item">
                        <div class="doc-info">
                            <div class="doc-name">${icon} ${filename}</div>
                            <div class="doc-meta">
                                ~${estimatedChunks} chunks • ${ext} file
                            </div>
                        </div>
                        <div class="doc-actions">
                            <button class="secondary" onclick="viewDocument('${filename}')">
                                👁️ View
                            </button>
                        </div>
                    </div>
                `;
            });
            
            html += '</div>';
            container.innerHTML = html;
        }
        
        async function viewDocument(filename) {
            alert(`View document: ${filename}\n\nTo see the actual chunks, use the chunk inspector tool:\npython inspect_chunks_simple.py`);
        }
        
        async function clearAllDocuments() {
            if (!confirm('⚠️ Clear all documents?\n\nThis will delete all uploaded documents and their chunks. This cannot be undone.')) {
                return;
            }
            
            try {
                const response = await fetch(`${API_BASE}/documents`, {
                    method: 'DELETE'
                });
                
                if (response.ok) {
                    alert('✅ All documents cleared successfully!');
                    loadData();
                } else {
                    const data = await response.json();
                    alert(`❌ Error: ${data.detail || 'Failed to clear documents'}`);
                }
            } catch (error) {
                alert(`❌ Error: ${error.message}`);
            }
        }
        
        // Load data on page load
        loadData();
        
        // Auto-refresh every 30 seconds
        setInterval(loadData, 30000);
    </script>
</body>
</html>